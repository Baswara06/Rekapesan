# Salin menjadi .env lalu isi nilainya. JANGAN commit .env.

# --- Database ---
DATABASE_URL=sqlite:///./rekapesan.db

# --- LLM utama (OpenRouter / NVIDIA NIM / lainnya yang kompatibel OpenAI API) ---
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=

# --- LLM cadangan (dipakai otomatis jika utama gagal / kuota habis) ---
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# --- Model vision untuk bukti bayar (boleh sama dengan LLM_MODEL jika mendukung gambar) ---
VISION_MODEL=

# --- Aplikasi ---
# Kunci penanda tangan token login. WAJIB diisi sendiri, minimal 16 karakter acak. Kosong atau nilai bawaan = login dimatikan.
# Buat: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=
DEMO_USERNAME=demo
# Kata sandi akun demo. Kosong = login dimatikan.
DEMO_PASSWORD=
JUMLAH_TIDAK_WAJAR_DEFAULT=20
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
